{
  "name": "digiward",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DigiWard: a browsable, filterable digital wardrobe with wear rotation and collection gap analysis.",
  "scripts": {
    "dev": "vite app",
    "build": "tsc -p app/tsconfig.json --noEmit && vite build app",
    "preview": "vite preview app",
    "test": "vitest run --config app/vitest.config.ts",
    "test:watch": "vitest --config app/vitest.config.ts",
    "publish": "npm run build && node scripts/publish-pages.mjs",
    "hero": "node scripts/make-hero.mjs && node scripts/optimize-hero.mjs",
    "optimize:hero": "node scripts/optimize-hero.mjs"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
